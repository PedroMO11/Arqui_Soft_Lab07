    },
    {
      "id": "te88",
      "type": "text",
      "x": 16,
      "y": 2860,
      "width": 723.5200000000001,
      "height": 85,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1820542803,
      "version": 2,
      "versionNonce": 1066234097,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792380729005,
      "link": null,
      "locked": false,
      "text": "Solo la API. Un Hedging Client manda a cada servicio de lectura una o más\ncopias de la misma request, gana la primera respuesta y el resto se cancela.\nS10 es acción y siempre recibe 1 sola llamada. La respuesta sigue esperando\nlas 10 partes, por lo tanto converge completa.",
      "originalText": "Solo la API. Un Hedging Client manda a cada servicio de lectura una o más\ncopias de la misma request, gana la primera respuesta y el resto se cancela.\nS10 es acción y siempre recibe 1 sola llamada. La respuesta sigue esperando\nlas 10 partes, por lo tanto converge completa.",
      "fontSize": 17,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b28"
    },
