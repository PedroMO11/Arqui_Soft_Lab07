    {
      "id": "te94",
      "type": "text",
      "x": 16,
      "y": 3110,
      "width": 714.0000000000001,
      "height": 85,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1821801231,
      "version": 2,
      "versionNonce": 223505041,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792380729005,
      "link": null,
      "locked": false,
      "text": "Beneficio  p99 1.47 s → 41 ms con double+hedge-p95 (escenario R).\nCosto  carga x2.05 sobre los servicios (límite aceptado 3x), más llamadas\na terceros con rate limit o cobro por consulta, y más complejidad en la API\n(timers, cancelación, budget, p95 por servicio).",
      "originalText": "Beneficio  p99 1.47 s → 41 ms con double+hedge-p95 (escenario R).\nCosto  carga x2.05 sobre los servicios (límite aceptado 3x), más llamadas\na terceros con rate limit o cobro por consulta, y más complejidad en la API\n(timers, cancelación, budget, p95 por servicio).",
      "fontSize": 17,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
